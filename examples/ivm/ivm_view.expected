commit 1: load 4 customers, 5 orders
  delta @1:
    + (east, 2, 80)
    + (west, 2, 90)
    + (north, 1, 10)
  view @1:
    (east, 2, 80)
    (west, 2, 90)
    (north, 1, 10)
commit 2: INSERT order 106; DELETE order 105 (last in north)
  delta @2:
    - (east, 2, 80)
    + (east, 3, 120)
    - (north, 1, 10)
  view @2:
    (east, 3, 120)
    (west, 2, 90)
commit 3: UPDATE customers SET region = west WHERE id = 1
  delta @3:
    - (east, 3, 120)
    + (east, 2, 70)
    - (west, 2, 90)
    + (west, 3, 140)
  view @3:
    (east, 2, 70)
    (west, 3, 140)
commit 4: UPDATE order 103 amount 70 -> 75; INSERT customer 5 (north), order 107
  delta @4:
    - (west, 3, 140)
    + (west, 3, 145)
    + (north, 1, 5)
  view @4:
    (east, 2, 70)
    (west, 3, 145)
    (north, 1, 5)
commit 5: INSERT customer 6 with no orders
  delta @5:
    (no change)
  view @5:
    (east, 2, 70)
    (west, 3, 145)
    (north, 1, 5)
ok: view matched recomputation at every commit
