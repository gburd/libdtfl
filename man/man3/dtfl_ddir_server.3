.Dt DTFL_DDIR_SERVER 3
.Os
.Sh NAME
.Nm dtfl_ddir_server_new ,
.Nm dtfl_ddir_server_free ,
.Nm dtfl_ddir_server_epoch ,
.Nm dtfl_ddir_server_has_trace ,
