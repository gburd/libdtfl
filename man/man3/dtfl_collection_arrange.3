.Nd arrange a collection into a shared, reusable trace
.Sh LIBRARY
Timely and differential dataflow library
.Pq libdtfl , \-ldtfl
.Sh SYNOPSIS
.In dtfl/arrange.h
.Ft dtfl_arranged *
.Fn dtfl_collection_arrange "dtfl_collection *c" "const char *name"
.Ft dtfl_arranged *
