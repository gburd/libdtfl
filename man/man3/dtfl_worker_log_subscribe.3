.Nd subscribe to structured timely and differential event logs
.Sh LIBRARY
Timely and differential dataflow library
.Pq libdtfl , \-ldtfl
.Sh SYNOPSIS
.In dtfl/log.h
.Ft int
.Fn dtfl_worker_log_subscribe "dtfl_worker *w" "const char *stream" "dtfl_log_subscriber_fn fn" "void *ctx" "void (*ctx_free)(void *)"
