def git(repo, *args):
    path = os.path.expanduser("~/src/" + repo)
    return subprocess.run(["git", "-C", path, *args], capture_output=True,
                          text=True, check=True).stdout


def read(path, ncols):
    rows = {}
    if not os.path.exists(path):
        return rows
    for line in open(path):
        if line.startswith("#") or line.startswith("repo\t"):
            continue
        cols = line.rstrip("\n").split("\t")
        cols += [""] * (ncols - len(cols))
        rows[tuple(cols[:2]) if ncols == 7 else (cols[0], cols[1], cols[3])] = cols
    return rows


def map_path(repo, path):
    for pat, tgt, phase, rest in RULES[repo]:
        if re.search(pat, path):
            status, note = rest.split("\t", 1)
            return [re.sub(pat, tgt, path), phase, status, note]
    sys.exit("ledger-diff: no rule maps %s:%s; add one to RULES" % (repo, path))


def scan_ports(old):
    rows = []
    for repo, tag in PIN.items():
        for path in git(repo, "ls-tree", "-r", "--name-only", tag).split():
            if SKIP.search(path) or not KEEP.search(path):
                continue
            if path.endswith(".md") and not path.startswith("mdbook/src/"):
                continue
            lines = str(git(repo, "show", "%s:%s" % (tag, path)).count("\n"))
            prev = old.get((repo, path))
            rest = prev[3:7] if prev else map_path(repo, path)
            rows.append([repo, path, lines] + rest)
    return rows


def scan_tests(ports):
    owner = {(r[0], r[1]): r for r in ports}
    rows = []
    for repo in ("timely-dataflow", "differential-dataflow"):
        tag = PIN[repo]
        hits = git(repo, "grep", "-l", r"#\[test\]", tag, "--", "*.rs").split()
        for hit in hits:
            path = hit.split(":", 1)[1]
            src = git(repo, "show", "%s:%s" % (tag, path)).splitlines()
            for i, line in enumerate(src):
                if not re.match(r"\s*#\[test\]", line):
                    continue
                panic, name = False, None
                for j in range(i, min(i + 8, len(src))):
                    panic |= "should_panic" in src[j]
                    m = re.search(r"\bfn\s+(\w+)", src[j])
                    if m:
                        name = m.group(1)
                        break
                o = owner[(repo, path)]
                tgt = o[3]
                if tgt != "-" and not tgt.startswith("tests/"):
                    base = re.sub(r"\.[ch]$", "", os.path.basename(tgt))
                    tgt = "tests/unit/test_" + base + ".c"
                rows.append([repo, path, str(i + 1), qualify(path, src, i, name),
                             "panic" if panic else "pass", tgt, o[4], o[5]])
    return rows


def qualify(path, src, line, name):
    # <module>__<name>: the Rust module path below src/ or tests/, plus the
    # innermost top-level inline `mod` (other than `tests`) enclosing the test.
    mod = re.sub(r"^.*?/(src|tests)/", "", path)
    mod = re.sub(r"(/mod|/lib)?\.rs$", "", mod).replace("/", "_")
    inner = None
    for text in src[:line]:
        m = re.match(r"(?:pub(?:\(crate\))? )?mod (\w+)\s*\{", text)
        if m:
            inner = m.group(1)
    if inner and inner != "tests":
        mod += "_" + inner
    return "%s__%s" % (mod, name)


def keep_test_status(rows, old):
    # A test row's status can run ahead of its file's (tests land first).
    for r in rows:
        prev = old.get((r[0], r[1], r[3]))
        if prev and prev[7] in ("wip", "done"):
            r[7] = prev[7]
    return rows


def report(kind, old_keys, new_keys):
    added = sorted(new_keys - old_keys)
    removed = sorted(old_keys - new_keys)
    for k in added:
        print("%s + %s" % (kind, ":".join(k)))
    for k in removed:
        print("%s - %s" % (kind, ":".join(k)))
    return len(added) + len(removed)


def main():
    old_ports, old_tests = read(PORT, 7), read(TEST, 8)
    ports = scan_ports(old_ports)
    tests = keep_test_status(scan_tests(ports), old_tests)
    changes = report("port", set(old_ports), {(r[0], r[1]) for r in ports})
    changes += report("test", set(old_tests), {(r[0], r[1], r[3]) for r in tests})
    if "--write" in sys.argv[1:]:
        with open(PORT, "w") as f:
            f.write("\n".join(PORT_HDR + ["\t".join(r) for r in ports]) + "\n")
        with open(TEST, "w") as f:
            f.write("\n".join(TEST_HDR + ["\t".join(r) for r in tests]) + "\n")
        print("ledger-diff: wrote %d files, %d tests" % (len(ports), len(tests)))
        return 0
    print("ledger-diff: %d change(s)" % changes)
    return 1 if changes else 0


if __name__ == "__main__":
    sys.exit(main())
